# Registry credentials — server-side only.
#
# These are read by src/lib/registries/*/server.ts inside the API route. They are
# never exposed to the browser: no NEXT_PUBLIC_ prefix, and importing the server
# adapters from a client component is a build error. In a real deployment these
# come from a secret manager, resolved per tenant connection.

# --- Isometric Certify (MRV API v0) -------------------------------------------
# Sandbox and production credentials are separate accounts. See
# https://docs.isometric.com/api-reference/authentication
#
# Client secret identifies this integration; it is tied to one environment.
ISOMETRIC_CLIENT_SECRET=
# Org-scoped JWT access token. Expires 1 year after generation.
ISOMETRIC_ACCESS_TOKEN=
# The one project this token may read, e.g. prj_1CTWZQGKE1S0VAXA
ISOMETRIC_PROJECT_ID=

# --- Data Sentinel (server-side BFF only) ------------------------------------
# FastAPI sidecar. The browser never sees these values.
# Local: docker compose in apps/sentinel (postgres, redis, backend, worker, beat).
# Operator UI is this Next app (`npm run dev` from repo root). Do not bind another UI to :3000.
SENTINEL_BASE_URL=http://localhost:8000
# Must match Data Sentinel SENTINEL_SERVICE_TOKEN (compose default below).
SENTINEL_SERVICE_TOKEN=local-sentinel-m2m-token
# 3DMinRV tenant that may call the proxy (in-house: 44.01).
SENTINEL_TENANT_ID=fourfourone
# Optional pin of catalog id → Sentinel UUID. Quality Console binds this in
# session state; omit in local dev.
# SENTINEL_PROJECT_MAP=

# --- Operator login (Cognito in eu-west-2; no LocalStack) ---------------------
# Until `make deploy` creates the identity stack, localhost only:
# AUTH_DEV_USER=you@4401.earth
# AUTH_DEV_TENANT=fourfourone
# AUTH_DEV_ROLE=platform_admin
# After the pool exists, set the real values from stack outputs / Secrets Manager:
# SESSION_KEY=
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=
# COGNITO_DOMAIN=minrv-ew2-sandbox.auth.eu-west-2.amazoncognito.com
# COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
# AUTH_DISABLED is not supported.
