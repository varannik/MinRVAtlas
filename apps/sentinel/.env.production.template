# ─────────────────────────────────────────────────────────────────────────────
# DataSentinel — Production Environment Variables
# Copy this file to .env.production and fill in all values before deploying.
# NEVER commit .env.production to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Matches the postgres service in docker-compose.yml
DATABASE_URL=postgresql://datasentinel:datasentinel_dev@postgres:5432/datasentinel

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# ⚠ REQUIRED — generate a fresh key and replace the placeholder below:
#   python3 -c "import secrets; print(secrets.token_hex(64))"
# DO NOT use the placeholder value. The server will refuse to start in production
# if this matches the default weak key.
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── File storage ──────────────────────────────────────────────────────────────
# Local dev only — in production (ECS Fargate) files go to S3; UPLOAD_DIR is used only as tmp write dir
UPLOAD_DIR=/app/uploads

# ── AWS S3 (production file storage) ─────────────────────────────────────────
# Leave blank in local dev to use local filesystem. Set in production via Secrets Manager.
AWS_S3_BUCKET=
AWS_REGION=eu-west-2

# ── GenAI Recommendations (optional) ─────────────────────────────────────────
# If set, Anomaly Detection uses Claude API for contextual recommendations.
# If not set, the rule-based fallback engine is used automatically.
ANTHROPIC_API_KEY=

# ── Session ───────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Shared secret for the 3DMinRV Next.js BFF. Must match the web task secret.
# Local compose defaults to local-sentinel-m2m-token if unset.
SENTINEL_SERVICE_TOKEN=

# ── CORS ──────────────────────────────────────────────────────────────────────
# ⚠ REQUIRED — set to your actual production domain(s) (comma-separated).
# The wildcard "*" is blocked in production — the server will refuse to start.
ALLOWED_ORIGINS=https://yourdomain.com

# ── Email / SMTP alerts (optional) ──────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ── Microsoft Entra ID (optional; Quality Console does not use SSO) ──────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
FRONTEND_URL=http://localhost:3000

# ── Postgres service credentials (must match DATABASE_URL above) ──────────────
POSTGRES_USER=datasentinel
POSTGRES_PASSWORD=datasentinel_dev
POSTGRES_DB=datasentinel

# ── Error tracking (optional) ────────────────────────────────────────────────
# Get DSN from https://sentry.io — leave blank to disable
SENTRY_DSN=
