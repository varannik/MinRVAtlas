# DataSentinel — Environment Variables
# Copy this file to .env in the backend/ directory for local dev outside Docker

DATABASE_URL=postgresql://datasentinel:datasentinel_dev@localhost:5432/datasentinel
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=dev-secret-key-change-in-production
ENVIRONMENT=development
UPLOAD_DIR=./uploads
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Shared with 3DMinRV Next BFF (Authorization: Bearer). Must match Next SENTINEL_SERVICE_TOKEN.
SENTINEL_SERVICE_TOKEN=local-sentinel-m2m-token
