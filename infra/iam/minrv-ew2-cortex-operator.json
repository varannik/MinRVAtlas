{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CortexTenancyTable",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:Query"],
      "Resource": "arn:aws:dynamodb:eu-west-2:625239230739:table/minrv-ew2-*-cortex-tenancy"
    },
    {
      "Sid": "CortexTenantSessionForLocalWeb",
      "Effect": "Allow",
      "Action": ["sts:AssumeRole", "sts:TagSession"],
      "Resource": "arn:aws:iam::625239230739:role/minrv-ew2-*-cortex-tenant-session"
    },
    {
      "Sid": "CortexRemovalsForLocalWeb",
      "Effect": "Allow",
      "Action": ["states:StartExecution"],
      "Resource": "arn:aws:states:eu-west-2:625239230739:stateMachine:minrv-ew2-*-cortex-removal"
    },
    {
      "Sid": "CortexIngestionRuns",
      "Effect": "Allow",
      "Action": ["states:ListExecutions"],
      "Resource": "arn:aws:states:eu-west-2:625239230739:stateMachine:minrv-ew2-*-cortex-ingestion"
    },
    {
      "Sid": "CortexIngestionRunDetail",
      "Effect": "Allow",
      "Action": ["states:DescribeExecution", "states:GetExecutionHistory"],
      "Resource": "arn:aws:states:eu-west-2:625239230739:execution:minrv-ew2-*-cortex-ingestion:*"
    },
    {
      "Sid": "CortexIndexJobs",
      "Effect": "Allow",
      "Action": ["bedrock:ListIngestionJobs", "bedrock:GetIngestionJob"],
      "Resource": "arn:aws:bedrock:eu-west-2:625239230739:knowledge-base/*"
    },
    {
      "Sid": "CortexTenancyTableKey",
      "Effect": "Allow",
      "Action": ["kms:Decrypt", "kms:GenerateDataKey"],
      "Resource": "arn:aws:kms:eu-west-2:625239230739:key/*",
      "Condition": {
        "StringEquals": { "kms:ViaService": "dynamodb.eu-west-2.amazonaws.com" },
        "ForAnyValue:StringLike": { "kms:ResourceAliases": "alias/minrv-ew2-*" }
      }
    }
  ]
}
