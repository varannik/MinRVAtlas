{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CortexTenancyTable",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:Query", "dynamodb:UpdateItem", "dynamodb:ConditionCheckItem"],
      "Resource": [
        "arn:aws:dynamodb:eu-west-2:625239230739:table/minrv-ew2-*-cortex-tenancy",
        "arn:aws:dynamodb:eu-west-2:625239230739:table/minrv-ew2-*-cortex-requirements"
      ]
    },
    {
      "Sid": "AtlasSeed",
      "Effect": "Allow",
      "Action": ["dynamodb:DescribeTable", "dynamodb:PutItem", "dynamodb:GetItem", "dynamodb:Query"],
      "Resource": "arn:aws:dynamodb:eu-west-2:625239230739:table/minrv-ew2-*-atlas"
    },
    {
      "Sid": "AtlasSeedSavedPins",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:eu-west-2:625239230739:parameter/minrv/ew2/*/project-locations"
    },
    {
      "Sid": "CortexTenantSessionForLocalWeb",
      "Effect": "Allow",
      "Action": ["sts:AssumeRole", "sts:TagSession"],
      "Resource": "arn:aws:iam::625239230739:role/minrv-ew2-*-cortex-tenant-session"
    },
    {
      "Sid": "CortexRemovalsReviewsAndMovesForLocalWeb",
      "Effect": "Allow",
      "Action": ["states:StartExecution"],
      "Resource": [
        "arn:aws:states:eu-west-2:625239230739:stateMachine:minrv-ew2-*-cortex-removal",
        "arn:aws:states:eu-west-2:625239230739:stateMachine:minrv-ew2-*-cortex-review",
        "arn:aws:states:eu-west-2:625239230739:stateMachine:minrv-ew2-*-cortex-move",
        "arn:aws:states:eu-west-2:625239230739:stateMachine:minrv-ew2-*-cortex-propose-requirements"
      ]
    },
    {
      "Sid": "CortexAgentRuntimeForDeployAndChecks",
      "Effect": "Allow",
      "Action": ["bedrock-agentcore:ListAgentRuntimes", "bedrock-agentcore:GetAgentRuntime"],
      "Resource": "arn:aws:bedrock-agentcore:eu-west-2:625239230739:runtime/*"
    },
    {
      "Sid": "CortexAgentModelForLocalRuns",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:eu-west-2:625239230739:inference-profile/eu.anthropic.claude-sonnet-4-6",
        "arn:aws:bedrock:eu-*::foundation-model/anthropic.claude-sonnet-4-6",
        "arn:aws:bedrock:eu-west-2:625239230739:inference-profile/eu.anthropic.claude-opus-5-5",
        "arn:aws:bedrock:eu-*::foundation-model/anthropic.claude-opus-5-5"
      ]
    },
    {
      "Sid": "QualityRuns",
      "Effect": "Allow",
      "Action": ["states:StartExecution", "states:ListExecutions"],
      "Resource": "arn:aws:states:eu-west-2:625239230739:stateMachine:minrv-ew2-*-quality-run"
    },
    {
      "Sid": "QualityRunDetail",
      "Effect": "Allow",
      "Action": ["states:DescribeExecution", "states:GetExecutionHistory"],
      "Resource": "arn:aws:states:eu-west-2:625239230739:execution:minrv-ew2-*-quality-run:*"
    },
    {
      "Sid": "CortexIngestionRuns",
      "Effect": "Allow",
      "Action": ["states:ListExecutions"],
      "Resource": "arn:aws:states:eu-west-2:625239230739:stateMachine:minrv-ew2-*-cortex-ingestion"
    },
    {
      "Sid": "CortexIngestionRunDetail",
      "Effect": "Allow",
      "Action": ["states:DescribeExecution", "states:GetExecutionHistory"],
      "Resource": "arn:aws:states:eu-west-2:625239230739:execution:minrv-ew2-*-cortex-ingestion:*"
    },
    {
      "Sid": "CortexIndexJobs",
      "Effect": "Allow",
      "Action": ["bedrock:ListIngestionJobs", "bedrock:GetIngestionJob"],
      "Resource": "arn:aws:bedrock:eu-west-2:625239230739:knowledge-base/*"
    },
    {
      "Sid": "CortexTenancyTableKey",
      "Effect": "Allow",
      "Action": ["kms:Decrypt", "kms:GenerateDataKey"],
      "Resource": "arn:aws:kms:eu-west-2:625239230739:key/*",
      "Condition": {
        "StringEquals": { "kms:ViaService": "dynamodb.eu-west-2.amazonaws.com" },
        "ForAnyValue:StringLike": { "kms:ResourceAliases": "alias/minrv-ew2-*" }
      }
    }
  ]
}
