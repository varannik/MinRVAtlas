# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
# ...but not a route named coverage (the data quality page's /api/data-quality/[id]/coverage).
!apps/web/src/app/**/coverage/

# next.js
apps/web/.next/
apps/web/out/

# production
build/

# local commit message (git commit -F COMMIT_MSG)
COMMIT_MSG

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep examples / templates)
.env*
!.env.example
!.env.production.template

# local operator overlays (lat/lng) when not running on ECS
.data/

# Cortex library: third-party documents to upload, kept out of git (their README is tracked)
docs/cortex-library/**/*.pdf
docs/cortex-library/**/*.docx
docs/cortex-library/**/*.doc
apps/web/.data/

# capture output (not product assets)
shots/

# cdk
/infra/cdk.out
/infra/node_modules
/infra/.cdk.staging

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
apps/web/next-env.d.ts

# python
__pycache__/
*.pyc

# Project documents stay on this machine: notes already tracked in docs/ are kept, new files are not added.
/docs/
